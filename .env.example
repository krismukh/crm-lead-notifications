# Copy to .env and fill in. .env is ignored by git.

# Slack incoming webhook for #new-lead-alerts (Phase 0)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXX/XXXX/XXXX

# Close webhook signature key, issued with the subscription (Phase 5). Leave blank until then.
CLOSE_WEBHOOK_SIGNATURE_KEY=

# Public lead-owner lookup (Phase 3)
LEAD_OWNER_BASE_URL=https://dea-lead-owner.s3.us-east-1.amazonaws.com

# Deployed receiver (Phase 2). FUNCTION_KEY is the function key; keep it only in .env.
FUNCTION_URL=https://func-crmleads-kcm.azurewebsites.net/api/crm
FUNCTION_KEY=
