{
  "version": "2.0",
  "logging": {
    "logLevel": {
      "default": "Information",
      "leadflow": "Information",
      "Host.Results": "Information"
    },
    "applicationInsights": {
      "samplingSettings": { "isEnabled": false }
    }
  },
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.*, 5.0.0)"
  },
  "extensions": {
    "serviceBus": {
      "prefetchCount": 0,
      "maxConcurrentCalls": 8,
      "autoCompleteMessages": false
    }
  }
}
