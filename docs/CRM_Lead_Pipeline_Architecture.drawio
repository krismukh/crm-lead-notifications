        <!-- Legend -->
        <mxCell id="legend" value="&lt;b&gt;Flow&lt;/b&gt;: lead created → event stored in source within seconds → 10-minute scheduled delay → lead owner looked up and merged on lead_id → enriched record in target → Slack alert. Each lead is keyed by lead_id and processed under peek-lock, so parallel leads never collide." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#404040;whiteSpace=wrap;" vertex="1" parent="1">
